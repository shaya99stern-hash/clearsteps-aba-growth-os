generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Territory {
  id             String   @id @default(cuid())
  name           String
  kind           String
  state          String?
  county         String?
  city           String?
  zip            String?
  demandScore    Int      @default(0)
  confidence     Int      @default(0)
  signalJson     String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organizations  Organization[]
  signals        Signal[]
  researchRuns   ResearchRun[]
  opportunities  ReferralOpportunity[]

  @@index([state, county, city, zip])
}

model Organization {
  id             String   @id @default(cuid())
  name           String
  normalizedName String
  type           String?
  website        String?
  domain         String?
  phone          String?
  email          String?
  status         String   @default("discovered")
  score          Int      @default(0)
  confidence     Int      @default(0)
  territoryId    String?
  territory      Territory? @relation(fields: [territoryId], references: [id])
  locations      OrganizationLocation[]
  contacts       Contact[]
  evidence       EvidenceRecord[]
  opportunities  ReferralOpportunity[]
  activities     Activity[]
  tasks          Task[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([normalizedName])
  @@index([domain])
  @@index([territoryId])
}

model OrganizationLocation {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  address1       String?
  address2       String?
  city           String?
  state          String?
  zip            String?
  latitude       Float?
  longitude      Float?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([state, city, zip])
}

model Professional {
  id             String   @id @default(cuid())
  fullName       String
  credentialType String?
  credentialId   String?
  npi            String?
  website        String?
  email          String?
  phone          String?
  city           String?
  state          String?
  sourcePolicy   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([credentialType, credentialId])
  @@index([npi])
  @@index([state, city])
}

model Candidate {
  id             String   @id @default(cuid())
  fullName       String
  role           String
  stage          String   @default("Discovered")
  email          String?
  phone          String?
  city           String?
  state          String?
  score          Int      @default(0)
  confidence     Int      @default(0)
  sourceJson     String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tasks          Task[]
  activities     Activity[]

  @@index([role, stage])
  @@index([state, city])
}

model ReferralOpportunity {
  id             String   @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  territoryId    String?
  territory      Territory? @relation(fields: [territoryId], references: [id])
  stage          String   @default("Discovered")
  score          Int      @default(0)
  confidence     Int      @default(0)
  reasonsJson    String   @default("[]")
  unknownsJson   String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([stage, score])
  @@index([organizationId])
  @@index([territoryId])
}

model CrmLead {
  id           String   @id @default(cuid())
  sourceKey    String   @unique
  name         String
  kind         String
  pipeline     String
  stage        String   @default("Discovered")
  score        Int      @default(0)
  confidence   Int      @default(0)
  website      String?
  domain       String?
  location     String?
  primaryEmail String?
  primaryPhone String?
  evidenceJson Json     @default("[]")
  reasonsJson  Json     @default("[]")
  unknownsJson Json     @default("[]")
  signalsJson  Json     @default("[]")
  savedAt      DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([pipeline, stage])
  @@index([kind, score])
  @@index([domain])
}

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String?
  title          String?
  role           String?
  email          String?
  phone          String?
  confidence     Int      @default(0)
  sourceUrl      String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([email])
}

model EvidenceRecord {
  id             String   @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  entityType     String
  entityId       String
  sourceId       String
  purpose        String
  title          String?
  url            String?
  snippet        String?
  query          String?
  confidence     Int      @default(0)
  capturedAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([sourceId])
  @@index([organizationId])
}

model ResearchRun {
  id             String   @id @default(cuid())
  query          String
  location       String?
  status         String   @default("running")
  planJson       String   @default("{}")
  sourceJson     String   @default("[]")
  screenedCount  Int      @default(0)
  qualifiedCount Int      @default(0)
  errorsJson     String   @default("[]")
  territoryId    String?
  territory      Territory? @relation(fields: [territoryId], references: [id])
  createdAt      DateTime @default(now())
  completedAt    DateTime?

  @@index([status, createdAt])
}

model Signal {
  id             String   @id @default(cuid())
  territoryId    String
  territory      Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  type           String
  strength       Int
  confidence     Int
  sourceId       String
  sourceUrl      String?
  summary        String
  capturedAt     DateTime @default(now())

  @@index([territoryId, type])
}

model ScoreSnapshot {
  id             String   @id @default(cuid())
  entityType     String
  entityId       String
  score          Int
  confidence     Int
  breakdownJson  String   @default("{}")
  reasonsJson    String   @default("[]")
  createdAt      DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

model Campaign {
  id             String   @id @default(cuid())
  name           String
  status         String   @default("draft")
  channel        String   @default("email")
  template       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  recipients     CampaignRecipient[]
}

model CampaignRecipient {
  id             String   @id @default(cuid())
  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  entityType     String
  entityId       String
  email          String?
  status         String   @default("queued")
  sentAt         DateTime?
  repliedAt      DateTime?
  optedOutAt     DateTime?

  @@index([campaignId, status])
}

model Task {
  id             String   @id @default(cuid())
  title          String
  description    String?
  status         String   @default("open")
  priority       String   @default("normal")
  dueAt          DateTime?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  candidateId    String?
  candidate      Candidate? @relation(fields: [candidateId], references: [id])
  entityType     String?
  entityId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, dueAt])
  @@index([organizationId])
  @@index([candidateId])
}

model Activity {
  id             String   @id @default(cuid())
  type           String
  summary        String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  candidateId    String?
  candidate      Candidate? @relation(fields: [candidateId], references: [id])
  entityType     String?
  entityId       String?
  metadataJson   String   @default("{}")
  createdAt      DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([organizationId])
  @@index([candidateId])
}

model SuppressionRecord {
  id             String   @id @default(cuid())
  value          String   @unique
  kind           String
  reason         String?
  createdAt      DateTime @default(now())
}

model Connector {
  id             String   @id
  name           String
  type           String
  status         String
  apiKeyRequired Boolean  @default(false)
  health         String
  usageNote      String
  updatedAt      DateTime @updatedAt
}

model AuditEvent {
  id             String   @id @default(cuid())
  action         String
  entityType     String?
  entityId       String?
  detailJson     String   @default("{}")
  createdAt      DateTime @default(now())

  @@index([action, createdAt])
}
